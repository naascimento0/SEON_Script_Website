### Gradle ###
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

### IntelliJ IDEA ###
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

### VS Code ###
.vscode/

# Environment variables
.env

# Ignore generated diagrams (subfolders + files) but keep fixed images that are
# not part of the model. Must ignore the *contents* of images/ rather than the
# directory itself, otherwise Git won't descend into it to honor the exception.
**/images/*
!**/images/SEON_Architecture.png
!**/images/logo_nemo.svg
page/
/jars/
astah_seon.asta
/data/*.asta

# Frontend (React + Vite)
frontend/node_modules/
frontend/dist/

# Runtime publication list (seeded from classpath:/publications.json on first start)
/publications.json

# Generated OntoUML exports (regenerate with GET /api/ontouml/{name})
/data/ontouml-exports/

# Ferramentas auxiliares de validação (scripts/validate-ontouml.mjs)
scripts/node_modules/

# Arquivos locais de trabalho (rascunhos, credenciais, PDFs pessoais)
Utils/
